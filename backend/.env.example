# Application
APP_NAME="LHQS AI Gateway"
ENVIRONMENT=local

# Database
# SQLAlchemy async URL. Use this URL for the backend process.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lhqs_ai_gateway

# Optional psql URL for applying SQL scripts manually.
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/lhqs_ai_gateway

# Redis
REDIS_URL=redis://localhost:6379/0

# Admin API
ADMIN_TOKEN=change-me-admin-token

# Gateway limits
REQUEST_BODY_LIMIT_BYTES=2097152
NATIVE_STREAM_MAX_SECONDS=300
DEFAULT_TIMEOUT_SECONDS=60
DEFAULT_RATE_LIMIT_PER_MINUTE=120
CACHE_NAMESPACE=ai-gateway

# Frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
